# Session signing key. Required in production; generate with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres connection string.
# Leave empty locally to use the embedded PGlite database in ./data/pg.
# REQUIRED when deploying to Vercel or any serverless host: those instances
# have an ephemeral, read-only filesystem and cannot run the embedded database.
# Use a POOLED connection string (Neon/Supabase pooler or PgBouncer).
DATABASE_URL=

# A database that production has used is marked, and development servers and
# preview deployments refuse to start against it (see docs/11-environments.md).
# Set to "true" only for a deliberate one-off, such as running a migration.
ALLOW_PRODUCTION_DATABASE=

# Set to "true" to load the demo practice into a Postgres database on first
# boot. It TRUNCATES the application tables first, so leave it unset for any
# database holding real data. The embedded local database always seeds itself.
SEED_DEMO_DATA=

# Optional. Upgrades denial explanations from the built-in CARC/RARC rules to
# Claude-generated guidance. Only codes and de-identified context are sent.
ANTHROPIC_API_KEY=

# Email delivery for contact submissions. With no key the form still records
# every message; it just does not notify anyone, so set this before any campaign.
RESEND_API_KEY=
# Must be a domain verified with the provider or sending is rejected.
CONTACT_FROM_EMAIL=CollaboratMD <notifications@collaboratmd.com>
CONTACT_TO_EMAIL=hello@collaboratmd.com
INVESTOR_TO_EMAIL=investors@collaboratmd.com

# The site's public address, used in links sent to patients and in alerts.
# On Vercel the production domain is used when this is empty.
APP_URL=

# Required for the daily job (/api/cron/daily). Vercel Cron sends it as a
# bearer token; without it the job refuses to run.
CRON_SECRET=

# Platform operators (comma-separated emails): may load national code sets and
# receive error alerts.
PLATFORM_ADMIN_EMAILS=

# Operator alerts for new server errors and error bursts (see docs/07-operations.md).
# Phones get a text through the TWILIO_* settings below; the webhook gets a
# JSON POST of {"text": ...} (Slack incoming webhooks accept this).
OPS_ALERT_PHONES=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_THRESHOLD=25

# Deployment-wide defaults for integrations. Each practice can instead connect
# its own accounts in Settings > Integrations, which takes precedence.
CLEARINGHOUSE=
STEDI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Printed and mailed statements (Lob). A test_ key renders letters without mailing them.
LOB_API_KEY=
# Set to "1" only after a BAA with Anthropic covering ANTHROPIC_API_KEY is signed.
AI_PHI_ALLOWED=

# Local development and end-to-end tests only: where the embedded database lives.
PGLITE_DIR=

# CollaboratMD's own subscriptions (self-serve signup), on the platform's
# Stripe account, not a practice's. Create the products and prices in Stripe
# to match /pricing, then paste their price IDs here. Webhook endpoint:
# /api/platform/stripe/webhook (checkout.session.completed and
# customer.subscription.created/updated/deleted).
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=
PLATFORM_PRICE_ESSENTIALS=
PLATFORM_PRICE_ESSENTIALS_ANNUAL=
PLATFORM_PRICE_PROFESSIONAL=
PLATFORM_PRICE_PROFESSIONAL_ANNUAL=
# Optional per-claim usage: a metered price and its meter's event name.
PLATFORM_PRICE_CLAIMS=
PLATFORM_CLAIM_METER_EVENT=
# Free trial length for self-serve signups, in days (default 14).
TRIAL_DAYS=

# Claim attachments and prepared exports in a private Vercel Blob store instead
# of Postgres. Connect the store to the project (Storage tab), make sure your BAA
# with Vercel covers Blob, then set this to "blob". Existing attachments move
# over from the operator console.
FILE_STORAGE=

# Encryption keys for stored secrets, separate from AUTH_SECRET so either can
# be rotated. "id=base64key[,id=base64key]", current first; each key from
# openssl rand -base64 32. After setting or rotating, re-encrypt from /ops/practices.
SEAL_KEYS=

# How long the daily job keeps operational records, in days (see
# docs/07-operations.md, "Data retention"). Unset uses the default shown.
# A value below a rule's minimum is ignored; messages sent and the audit log
# are never kept less than six years.
# RETENTION_NOTIFICATIONS_DAYS=365
# RETENTION_UNREAD_NOTIFICATIONS_DAYS=730
# RETENTION_RESOLVED_ERRORS_DAYS=180
# RETENTION_INTEGRATION_CHECKS_DAYS=365
# RETENTION_WEBHOOK_DELIVERIES_DAYS=365
# RETENTION_USAGE_DAYS=730
# RETENTION_FEEDBACK_DAYS=730
# RETENTION_MESSAGES_DAYS=2555
# RETENTION_AUDIT_LOG_DAYS=2555
