# Session signing key. Required in production; generate with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres connection string.
# Leave empty locally to use the embedded PGlite database in ./data/pg.
# REQUIRED when deploying to Vercel or any serverless host: those instances
# have an ephemeral, read-only filesystem and cannot run the embedded database.
# Use a POOLED connection string (Neon/Supabase pooler or PgBouncer).
DATABASE_URL=

# Set to "true" to load the demo practice into a Postgres database on first
# boot. It TRUNCATES the application tables first, so leave it unset for any
# database holding real data. The embedded local database always seeds itself.
SEED_DEMO_DATA=

# Optional. Upgrades denial explanations from the built-in CARC/RARC rules to
# Claude-generated guidance. Only codes and de-identified context are sent.
ANTHROPIC_API_KEY=

# Email delivery for contact submissions. With no key the form still records
# every message; it just does not notify anyone, so set this before any campaign.
RESEND_API_KEY=
# Must be a domain verified with the provider or sending is rejected.
CONTACT_FROM_EMAIL=CollaboratMD <notifications@collaboratmd.com>
CONTACT_TO_EMAIL=hello@collaboratmd.com
INVESTOR_TO_EMAIL=investors@collaboratmd.com
