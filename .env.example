# Session signing secret (any long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Database
# Leave DATABASE_URL empty to use embedded PGlite (Postgres-in-WASM) stored in ./data/pg
# Set to a real Postgres URL for production, e.g. postgres://user:pass@host:5432/medbill
DATABASE_URL=

# Optional: enables AI-powered rejection explanations. Without it a rules-based explainer is used.
ANTHROPIC_API_KEY=
